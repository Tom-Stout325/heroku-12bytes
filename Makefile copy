# Create/refresh a local superuser using .env.airborne_local
seed-local-superuser:
	@echo "Seeding local superuser '$(SU_USERNAME)'..."
	ENV_FILE=.env.airborne_local DJANGO_SETTINGS_MODULE=$(SETTINGS) \
	SU_USERNAME="$(SU_USERNAME)" SU_EMAIL="$(SU_EMAIL)" SU_PASSWORD="$(SU_PASSWORD)" \
	$(PY) - <<'PY'
from django.contrib.auth import get_user_model
import os
User = get_user_model()
username = os.environ.get("SU_USERNAME")
email    = os.environ.get("SU_EMAIL")
password = os.environ.get("SU_PASSWORD")
u, created = User.objects.get_or_create(username=username, defaults={"email": email})
# ensure flags + email + password are correct every run
u.email = email or u.email
u.is_staff = True
u.is_superuser = True
u.set_password(password)
u.save()
print(f"{'Created' if created else 'Updated'} superuser '{u.username}' with email '{u.email}'.")
PY


